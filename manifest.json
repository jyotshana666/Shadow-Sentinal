{
  "manifest_version": 3,
  "name": "ShadowSentinel",
  "version": "1.0.0",
  "description": "Corporate AI governance — privacy-first session monitoring",
  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "webRequest",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["utils/storage.js", "content/content-script.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["auth/login.html"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "128": "icons/icon128.png"
  }
}
