# Shadow Sentinel Container Stack Environment Template
# Copy to .env and override with secure values prior to running docker compose up.

# PostgreSQL Configuration
DB_NAME=SHADOW_SENTINEL
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Security / JWT (Must be at least 256 bits / 32 bytes base64/hex)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_HERE

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
