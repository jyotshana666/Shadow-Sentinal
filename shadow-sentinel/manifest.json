{
  "manifest_version": 3,
  "name": "ShadowSentinel",
  "version": "1.0.0",
  "description": "Corporate AI governance — privacy-first session monitoring",
  "permissions": ["storage", "alarms", "webNavigation", "webRequest", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "constants/constants.js",
        "utils/storage.js",
        "collectors/ui-collector.js",
        "collectors/interaction-collector.js",
        "content/block-enforcer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [{
    "resources": ["auth/login.html"],
    "matches": ["<all_urls>"]
  }]
}
